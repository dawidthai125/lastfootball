# Local Next.js env — copy from repo root `.env.example`
# File is gitignored. Do not put production secrets here.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# Post-match note. Server-only. Leave empty to keep the template sentence.
# XAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# TAVILY_API_KEY=

# Optional bot check. Set both, or leave both empty.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
