# Last Football — environment contract (SSOT)
# Copy to apps/web/.env.local for local development.
# NEVER commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# --- Supabase (public / browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — never NEXT_PUBLIC_) ---
# SUPABASE_SERVICE_ROLE_KEY=

# --- Jobs / cron (server-only) ---
# CRON_SECRET=

# --- Post-match note (server-only; same names as Bitek) ---
# Chain: XAI_API_KEY, then GROQ_API_KEY, then GEMINI_API_KEY.
# TAVILY_API_KEY is the fourth shared key. The match note does not search the web.
# XAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# TAVILY_API_KEY=

# --- Bot check on signup (optional; both or neither) ---
# Cloudflare Turnstile. Supabase Auth does not verify Google reCAPTCHA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
